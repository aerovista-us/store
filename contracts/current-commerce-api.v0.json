{
  "contractVersion": "legacy-gear-v0",
  "lastVerified": "2026-07-22",
  "storeId": "aerovista-apparel",
  "publicBaseUrl": "https://gear.aerovista.us",
  "upstreamBaseUrl": "https://api.aerovista.us",
  "routes": [
    {
      "id": "health",
      "method": "GET",
      "path": "/api/health",
      "mutates": false,
      "routineLiveAudit": true,
      "successStatus": 200,
      "responseRequired": ["ok", "time", "square_env", "have", "allowed_origins"]
    },
    {
      "id": "bootstrap",
      "method": "GET",
      "path": "/api/square/bootstrap",
      "mutates": false,
      "routineLiveAudit": true,
      "successStatus": 200,
      "responseRequired": ["env", "appId", "locationId", "currency", "flatShippingCents", "promoCodes", "sellableCartKeys"]
    },
    {
      "id": "checkout",
      "method": "POST",
      "path": "/api/square/checkout",
      "mutates": true,
      "routineLiveAudit": false,
      "successStatus": 200,
      "requestRequired": ["cart"],
      "responseRequired": ["ok", "checkoutUrl", "idempotencyKey"]
    },
    {
      "id": "square-webhook",
      "method": "POST",
      "path": "/api/webhooks/square",
      "mutates": true,
      "routineLiveAudit": false,
      "successStatus": 200,
      "authentication": "x-square-hmacsha256-signature"
    },
    {
      "id": "operations-database",
      "method": "GET",
      "path": "/api/ops/db",
      "mutates": false,
      "routineLiveAudit": false,
      "successStatus": 200,
      "authentication": "X-Ops-Token"
    },
    {
      "id": "catalog-live",
      "method": "GET",
      "path": "/api/catalog/live",
      "mutates": true,
      "routineLiveAudit": false,
      "successStatus": 200,
      "responseRequired": ["ok", "storeId", "products", "imageManifest"],
      "note": "May initialize Postgres from the mounted catalog when no row exists."
    },
    {
      "id": "catalog-meta",
      "method": "GET",
      "path": "/api/catalog/meta",
      "mutates": false,
      "routineLiveAudit": false,
      "successStatus": 200,
      "responseRequired": ["ok", "inDatabase"]
    },
    {
      "id": "catalog-publish",
      "method": "POST",
      "path": "/api/catalog/publish",
      "mutates": true,
      "routineLiveAudit": false,
      "successStatus": 200,
      "authentication": "X-Ops-Token",
      "requestRequired": ["catalog"]
    },
    {
      "id": "catalog-sync-from-disk",
      "method": "POST",
      "path": "/api/catalog/sync-from-disk",
      "mutates": true,
      "routineLiveAudit": false,
      "successStatus": 200,
      "authentication": "X-Ops-Token"
    }
  ],
  "identity": {
    "product": "catalog product.id",
    "cartCompatibilityKey": "Color__Size",
    "checkoutVariation": "cart line variationId",
    "providerCheckoutObject": "Square variation ID"
  },
  "authority": {
    "display": "catalog plus storefront overlay",
    "sellability": "bootstrap sellableCartKeys plus a valid selected Square variation ID",
    "price": "server-side SKU map or catalog checkout metadata",
    "checkoutTotal": "Square payment-link order",
    "fulfillment": "verified Square webhook plus provider mapping"
  },
  "compatibilityRules": [
    "Legacy /api routes remain available while Gear uses them.",
    "A selected cart variationId wins over a colliding Color__Size map entry.",
    "Client-sent price and cents fields are ignored by checkout.",
    "Routine live audits never call checkout or webhook routes.",
    "Existing /api/catalog routes remain available to the private operator console.",
    "Catalog publish and sync routes remain protected by X-Ops-Token and excluded from routine audits.",
    "Gear and future stores must use separate cart namespaces."
  ]
}
