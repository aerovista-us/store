{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aerovista.us/commerce/cart-quote-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["storeId", "currency", "items"],
  "properties": {
    "storeId": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/storeId" },
    "currency": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/currency" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "promoCode": { "type": "string", "minLength": 1, "maxLength": 64 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineId", "productId", "variantId", "quantity"],
        "properties": {
          "lineId": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/publicId" },
          "productId": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/publicId" },
          "variantId": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/publicId" },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 25 }
        }
      }
    }
  }
}
