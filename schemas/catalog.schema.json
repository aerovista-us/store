{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aerovista.us/commerce/catalog.schema.json",
  "title": "AeroVista Normalized Storefront Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "storeId", "currency", "products"],
  "properties": {
    "schemaVersion": { "const": "1.0.0-alpha.1" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "storeId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "products": {
      "type": "array",
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "title", "description", "visibility", "availability", "collections", "channels", "media", "optionGroups", "variants"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "visibility": { "enum": ["draft", "visible", "hidden", "archived"] },
        "availability": { "enum": ["available", "unavailable", "preorder", "discontinued"] },
        "collections": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "channels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assetId", "alt"],
            "properties": {
              "assetId": { "type": "string", "minLength": 1 },
              "alt": { "type": "string" },
              "legacySrc": { "type": "string", "minLength": 1 }
            }
          }
        },
        "optionGroups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "values"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "label": { "type": "string", "minLength": 1 },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "label": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "options", "price", "availability"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "sku": { "type": "string", "minLength": 1 },
              "options": {
                "type": "object",
                "additionalProperties": { "type": "string", "minLength": 1 }
              },
              "price": {
                "type": "object",
                "additionalProperties": false,
                "required": ["amount", "currency"],
                "properties": {
                  "amount": { "type": "integer", "minimum": 0 },
                  "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
                }
              },
              "availability": { "enum": ["available", "unavailable", "preorder", "discontinued"] }
            }
          }
        }
      }
    }
  }
}
