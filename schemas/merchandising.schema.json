{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aerovista.us/commerce/merchandising.schema.json",
  "title": "AeroVista Store Merchandising",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "merchandisingVersion", "storeId", "home", "collections", "overridesByProductId"],
  "properties": {
    "schemaVersion": { "const": "1.0.0-alpha.1" },
    "merchandisingVersion": { "type": "string", "minLength": 1 },
    "storeId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featuredProductIds", "featuredLimit", "sectionOrder"],
      "properties": {
        "featuredProductIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "featuredLimit": { "type": "integer", "minimum": 1, "maximum": 24 },
        "sectionOrder": {
          "type": "array",
          "items": { "enum": ["hero", "featured", "collections", "trust", "story", "signup"] },
          "uniqueItems": true
        }
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "order", "visible"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 },
          "visible": { "type": "boolean" }
        }
      }
    },
    "overridesByProductId": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "badge": { "type": "string" },
          "featured": { "type": "boolean" },
          "order": { "type": "integer", "minimum": 0 },
          "visibility": { "enum": ["inherit", "visible", "hidden"] }
        }
      }
    }
  }
}
