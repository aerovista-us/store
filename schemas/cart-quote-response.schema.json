{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aerovista.us/commerce/cart-quote-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["quoteId", "requestId", "storeId", "catalogVersion", "createdAt", "expiresAt", "currency", "checkoutEligible", "items", "discounts", "changes", "totals", "shippingStatus", "taxStatus"],
  "properties": {
    "quoteId": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/publicId" },
    "requestId": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/requestId" },
    "storeId": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/storeId" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "createdAt": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/timestamp" },
    "currency": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/currency" },
    "checkoutEligible": { "type": "boolean" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineId", "productId", "variantId", "title", "options", "quantity", "unitPrice", "lineSubtotal", "availability"],
        "properties": {
          "lineId": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/publicId" },
          "productId": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/publicId" },
          "variantId": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/publicId" },
          "title": { "type": "string", "minLength": 1 },
          "options": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/options" },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 25 },
          "unitPrice": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/money" },
          "lineSubtotal": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/money" },
          "availability": { "enum": ["available", "unavailable"] }
        }
      }
    },
    "discounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "label", "amount"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "amount": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/money" }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "lineId": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/publicId" },
          "code": { "enum": ["price_changed", "unavailable", "quantity_adjusted", "catalog_changed"] },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subtotal", "discount", "shipping", "tax", "total"],
      "properties": {
        "subtotal": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/money" },
        "discount": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/money" },
        "shipping": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/money" },
        "tax": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/money" },
        "total": { "$ref": "https://schemas.aerovista.us/commerce/common.schema.json#/$defs/money" }
      }
    },
    "shippingStatus": { "enum": ["not-calculated", "estimated", "final"] },
    "taxStatus": { "enum": ["not-calculated", "estimated", "final"] }
  }
}
