{
  "schemaVersion": "1.0.0-alpha.1",
  "storeVersion": "horizon-preview-fixture-v1",
  "environment": "fixture",
  "store": {
    "id": "horizon",
    "name": "AeroVista Horizon",
    "hostname": "horizon-preview.aerovista.us",
    "theme": "horizon",
    "currency": "USD",
    "locale": "en-US",
    "cartNamespace": "horizon"
  },
  "catalog": {
    "channel": "horizon",
    "defaultSort": "featured"
  },
  "home": {
    "hero": {
      "headline": "Aerial perspective, made tangible.",
      "summary": "Photographic works presented as prints and display pieces."
    },
    "featuredProductIds": ["fixture-coastal-ridge-study"],
