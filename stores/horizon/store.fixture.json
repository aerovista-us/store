    "collectionOrder": ["aerial-studies", "limited-editions"],
    "sectionOrder": ["hero", "featured", "collections", "trust", "story", "signup"]
  },
  "api": {
    "catalogPath": "/v1/storefront/horizon/catalog",
    "quotePath": "/v1/cart/quote",
    "checkoutPath": "/v1/checkout/session"
  },
  "policies": {
    "faq": "/policies#faq",
    "shipping": "/policies#shipping",
    "returns": "/policies#returns",
    "contact": "/policies#contact"
  }
