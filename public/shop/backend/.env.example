# Copy to `.env` and fill values. Do not commit `.env`.

# ---- Flask ----
APP_HOST=0.0.0.0
APP_PORT=8088
FLASK_DEBUG=0

# ---- CORS ----
# Exact allowed origins (comma-separated, no trailing slash)
# Example (GitHub Pages):
# ALLOWED_ORIGINS=https://aerovista-us.github.io
# Catalog Console on same network (e.g. Tailscale):
# ALLOWED_ORIGINS=...,http://100.115.9.61:8080
ALLOWED_ORIGINS=
# Optional single-origin fallback (used only if ALLOWED_ORIGINS is empty)
ALLOWED_ORIGIN=

# ---- Square ----
# For Sandbox testing, set SQUARE_ENV=sandbox and fill the *_SANDBOX values.
# By default the server uses the env configured by SQUARE_ENV. Set
# SQUARE_ALLOW_ENV_OVERRIDE=1 only if you intentionally want per-request override.
SQUARE_ENV=production
SQUARE_ALLOW_ENV_OVERRIDE=0

# Production credentials
SQUARE_ACCESS_TOKEN=
SQUARE_APP_ID=
SQUARE_LOCATION_ID=

# Sandbox credentials
SQUARE_ACCESS_TOKEN_SANDBOX=
SQUARE_APP_ID_SANDBOX=
SQUARE_LOCATION_ID_SANDBOX=

SQUARE_VERSION=2025-01-16

# ---- Checkout ----
CHECKOUT_CURRENCY=USD
SQUARE_FLAT_SHIPPING_CENTS=695
# Optional server-authoritative promo codes.
# Number values are treated as percent off (10 = 10%, 0.15 = 15%).
# Objects support:
#   {"type":"percent","value":10,"label":"10% off"}
#   {"type":"fixed_amount","amount_cents":500,"label":"$5 off"}
PROMO_CODES_JSON={"SEED10":{"type":"percent","value":10,"label":"10% off"},"CREW15":{"type":"percent","value":15,"label":"15% off"}}
# SKU map source order:
# 1) SQUARE_SKU_MAP_JSON (inline JSON), else
# 2) SQUARE_SKU_MAP_FILE (default: backend/sku_map.generated.json)
# Map entry schema: { "name": "Display name", "cents": 5500, "variationId": "SQ_VARIATION_ID_OPTIONAL" }
# Keys must match checkout cart sku (cartKey format, e.g. color__size).
# Example: SQUARE_SKU_MAP_JSON={"Default__M":{"name":"Hoodie (Black, M)","cents":5500,"variationId":"ABC123"}}
# If checkout returns 400: add an entry for each cart key (e.g. Black__M, Navy__L) with "name" and "cents".
SQUARE_SKU_MAP_JSON=
SQUARE_SKU_MAP_FILE=

# ---- Database (fulfillment bridge, job queue) ----
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=

# ---- Webhooks ----
# Optional: for Square webhook signature verification (must match Dashboard subscription)
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# Notification URL used in signature (default: https://api.aerovista.us/api/webhooks/square)
# SQUARE_WEBHOOK_NOTIFICATION_URL=

# ---- Printful (fulfillment worker) ----
# Private token from Printful Dashboard → API → Create a token (Orders scope)
# PRINTFUL_API_TOKEN=
