{
  "sot_version": "2.0-aerovista",
  "repo_context": {
    "parent_repository": "av_storefront",
    "parent_manifest": "../SOT.json",
    "description": "Sub-manifest for backend/ only; paths below are relative to backend/."
  },
  "project": {
    "name": "AeroVista Store API",
    "slug": "av-store-api",
    "brand": "AeroVista",
    "division": "AeroVista Apparel",
    "owner": "AeroVista LLC",
    "status": "active",
    "lifecycle": "production",
    "type": "api",
    "category": "checkout-fulfillment",
    "root": "./",
    "primary_language": "python",
    "repo_visibility": "private",
    "created": "2026-02-01",
    "updated": "2026-03-19",
    "timezone": "America/Los_Angeles"
  },
  "purpose": {
    "summary": "Flask API for Square bootstrap and hosted checkout (payment links), Square webhooks, Postgres-backed orders and fulfillment jobs, and Printful order submission via worker.",
    "source_of_truth_policy": "Cart line items resolve through SQUARE_SKU_MAP_JSON or sku_map.generated.json; variation IDs must match Square catalog. Environment secrets live only in .env.",
    "business_role": "Secure server-side checkout and post-payment fulfillment alignment with Square and Printful."
  },
  "technical_profile": {
    "stack": {
      "frontend": [],
      "backend": [
        "Python 3",
        "Flask",
        "SQLAlchemy 2.x",
        "Alembic",
        "psycopg3",
        "Gunicorn"
      ],
      "database": [
        "PostgreSQL 16"
      ],
      "infra": [
        "Docker",
        "Docker Compose",
        "Traefik",
        "Cloudflare Tunnel"
      ],
      "analytics": [],
      "ai": []
    },
    "runtime": {
      "local_ports": [
        8088
      ],
      "service_urls": [
        "https://api.aerovista.us"
      ],
      "health_endpoint": "/api/health",
      "entry_command": "python app.py (dev) or gunicorn -b 0.0.0.0:8088 app:app",
      "build_command": "docker compose build",
      "start_command": "docker compose -f docker-compose.local.yml up -d (local) or docker compose -f docker-compose.yml up -d (Traefik)"
    },
    "deployment": {
      "primary_host": "NXCore",
      "deploy_path": "/srv/core/ops/av-store-api/backend (example; see ../docs/DEPLOY_AV_STORE_API_NXCORE.md)",
      "public_url": "https://api.aerovista.us",
      "internal_url": "http://av-store-api:8088 on docker network",
      "containerized": true,
      "compose_file": "docker-compose.yml",
      "reverse_proxy": "Traefik",
      "networking_notes": "Host rule api.aerovista.us; external network nxtraefik_default; see docker-compose.yml labels."
    },
    "data_model": {
      "core_db_dependency": true,
      "domain_db": "PostgreSQL av_storefront (compose service postgres)",
      "canonical_event_ledger": "webhook_events, orders, fulfillment_jobs tables",
      "shared_storage": [
        "sku_map.generated.json or SQUARE_SKU_MAP_JSON env",
        "data/printful_variant_map.json after import script"
      ]
    }
  },
  "canon": {
    "canon_root": "./",
    "allowed_master_locations": [
      "./",
      "./db",
      "./scripts",
      "./templates",
      "./workers"
    ],
    "forbidden_master_locations": [
      "./.venv",
      "./__pycache__",
      "./.env",
      "./node_modules"
    ]
  },
  "entrypoints": [
    {
      "id": "flask_app",
      "label": "Flask application",
      "path": "app.py",
      "required": true,
      "notes": "Defines /api/* routes and ops dashboards."
    },
    {
      "id": "readme",
      "label": "Backend README",
      "path": "README.md",
      "required": true,
      "notes": "Setup, DATABASE_URL, CORS, compose files."
    }
  ],
  "canon_files": [
    {
      "id": "readme",
      "path": "README.md",
      "type": "md",
      "role": "API setup and operations",
      "required": true,
      "owner": "AeroVista",
      "status": "active"
    },
    {
      "id": "sot_self",
      "path": "SOT.json",
      "type": "json",
      "role": "subtree source of truth manifest",
      "required": true,
      "owner": "AeroVista",
      "status": "active"
    },
    {
      "id": "app_py",
      "path": "app.py",
      "type": "py",
      "role": "Flask application entry",
      "required": true,
      "owner": "AeroVista",
      "status": "active"
    },
    {
      "id": "compose_prod",
      "path": "docker-compose.yml",
      "type": "yml",
      "role": "postgres + av-store-api + fulfillment-worker + Traefik labels",
      "required": true,
      "owner": "AeroVista",
      "status": "active"
    },
    {
      "id": "compose_local",
      "path": "docker-compose.local.yml",
      "type": "yml",
      "role": "local dev with published 8088",
      "required": true,
      "owner": "AeroVista",
      "status": "active"
    },
    {
      "id": "env_example",
      "path": ".env.example",
      "type": "env",
      "role": "documented environment variables template",
      "required": true,
      "owner": "AeroVista",
      "status": "active"
    },
    {
      "id": "requirements",
      "path": "requirements.txt",
      "type": "txt",
      "role": "Python dependencies",
      "required": true,
      "owner": "AeroVista",
      "status": "active"
    },
    {
      "id": "fulfillment_worker",
      "path": "workers/fulfillment_worker.py",
      "type": "py",
      "role": "Printful submission worker",
      "required": true,
      "owner": "AeroVista",
      "status": "active"
    },
    {
      "id": "printful_export_script",
      "path": "scripts/printful_my_products_export.py",
      "type": "py",
      "role": "Offline Printful sync export to CSV",
      "required": false,
      "owner": "AeroVista",
      "status": "active"
    },
    {
      "id": "printful_map_build",
      "path": "scripts/build_printful_variant_map.py",
      "type": "py",
      "role": "Build printful_variant_map.json from CSV",
      "required": false,
      "owner": "AeroVista",
      "status": "active"
    },
    {
      "id": "db_tables",
      "path": "db/tables.py",
      "type": "py",
      "role": "SQLAlchemy table definitions",
      "required": true,
      "owner": "AeroVista",
      "status": "active"
    }
  ],
  "canon_folders": [
    {
      "id": "db",
      "path": "db/",
      "role": "migrations and ORM"
    },
    {
      "id": "scripts",
      "path": "scripts/",
      "role": "ops and mapping scripts"
    },
    {
      "id": "workers",
      "path": "workers/",
      "role": "background workers"
    },
    {
      "id": "templates",
      "path": "templates/",
      "role": "HTML dashboards"
    }
  ],
  "systems": {
    "linked_projects": [
      {
        "name": "av_storefront",
        "path": "../",
        "sot": "../SOT.json"
      }
    ],
    "depends_on": [
      "Square APIs (checkout, orders, webhooks)",
      "Printful API (fulfillment when configured)"
    ],
    "feeds": [
      "SKU map generated from repo root catalog (tools/generate_sku_map.py or scripts/refresh_catalog.py)"
    ],
    "consumes": [
      "https://connect.squareup.com",
      "https://api.printful.com"
    ],
    "shares_with": [],
    "related_domains": [
      "api.aerovista.us"
    ],
    "tailscale_hosts": [],
    "cloudflare_tunnels": [
      "Origin to NXCore for api.aerovista.us"
    ]
  },
  "ops": {
    "service_name": "av-store-api",
    "health_check_paths": [
      "/api/health"
    ],
    "backup_targets": [
      "Postgres volume pgdata",
      "Alembic-managed schema"
    ],
    "log_locations": [
      "docker logs av-store-api",
      "docker logs av-store-fulfillment-worker"
    ],
    "secrets_locations": [
      ".env (copy from .env.example)"
    ],
    "monitoring": {
      "enabled": false,
      "providers": []
    }
  },
  "governance": {
    "review_cycle": "when checkout, webhook, or fulfillment logic changes",
    "update_rule": "Update SOT when routes, compose, or env contract changes.",
    "promotion_rule": "Migrations reviewed before production deploy.",
    "archive_rule": "Generated sku_map.generated.json may be gitignored; regenerate from catalog.",
    "owner_roles": [
      "AeroVista ops"
    ]
  },
  "duplicates": [],
  "checks": {
    "required_paths_exist": [
      "SOT.json",
      "README.md",
      "app.py",
      "docker-compose.yml",
      "requirements.txt",
      ".env.example"
    ],
    "marker": {
      "enabled": true,
      "marker_key": "SOT:",
      "accepted_ext": [
        ".md",
        ".html",
        ".json",
        ".py",
        ".yml",
        ".yaml"
      ]
    },
    "hash_canon_files": false,
    "warn_on_duplicate_ids": true,
    "warn_on_missing_required": true,
    "warn_on_master_outside_allowed_locations": true
  },
  "notes": [
    "ALLOWED_ORIGINS must include storefront origin(s): e.g. https://aerovista-us.github.io and/or https://aerovista.us per README.md.",
    "PRINTFUL_API_TOKEN / PRINTFUL_TOKEN required for live Printful submission."
  ],
  "portfolio": {
    "division_slug": "aerovista-apparel",
    "portfolio_lane": "fund",
    "maturity_stage": 3,
    "maturity_label": "internal-usable",
    "system_role": "service-api",
    "exposure": "private-only",
    "strategic_tier": "core",
    "owner_team": "AeroVista Commerce",
    "owner_person": "glyph",
    "commercial_status": "supporting",
    "scorecard": {
      "security": 2,
      "reliability": 2,
      "data_safety": 2,
      "documentation": 2,
      "repeatability": 2,
      "owner_clarity": 3
    },
    "decision_notes": "Phase 3B metadata seed for canonical queue reduction."
  }
}
