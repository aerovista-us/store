{
  "name": "aerovista-store",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:shop": "npm run sync:store && vite --open /shop/index.html",
    "dev:console": "npm run sync:console && vite --open /console/",
    "prebuild": "npm run sync:all",
    "build": "tsc --noEmit && vite build",
    "build:pages": "node scripts/build-github-pages.mjs && node scripts/strip-private-pages-build.mjs && node scripts/audit-public-pages-build.mjs && node scripts/gh-pages-postbuild.mjs",
    "preview": "vite preview",
    "preview:pages": "npm run build:pages && vite preview --host 0.0.0.0",
    "sync:store": "node scripts/sync-store.mjs",
    "sync:console": "node scripts/sync-console.mjs",
    "sync:all": "node scripts/sync-store.mjs && node scripts/sync-console.mjs && node scripts/write-build-source-manifest.mjs",
    "console:server": "node console/server.js",
    "audit:overlay": "node scripts/audit-storefront-overlay.cjs",
    "clean:overlay": "node scripts/clean-storefront-overlay.mjs",
    "deploy:catalog": "node scripts/deploy-store-catalog.mjs",
    "curate:catalog": "node scripts/curate-catalog-lanes.mjs",
    "deploy:server": "node scripts/catalog-deploy-server.mjs",
    "audit:repo": "node scripts/audit-orphans.mjs",
    "audit:storefront": "node scripts/audit-storefront.mjs",
    "audit:checkout-keys": "node scripts/audit-checkout-keys.mjs",
    "build:cart-sku-map": "node scripts/build-cart-sku-map.mjs",
    "verify:checkout-fix": "node scripts/verify-live-checkout-fix.mjs",
    "deploy:gear-api-proxy": "npx wrangler deploy --config cloudflare/gear-api-proxy/wrangler.toml"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
