{
  "name": "aerovista-store",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:shop": "npm run sync:store && vite --open /shop/index.html",
    "dev:console": "npm run sync:console && vite --open /console/",
    "prebuild": "npm run sync:all",
    "build": "tsc --noEmit && vite build",
    "build:pages": "node scripts/build-github-pages.mjs && node scripts/strip-private-pages-build.mjs && node scripts/audit-public-pages-build.mjs && node scripts/gh-pages-postbuild.mjs",
    "build:horizon-pages": "node horizon/scripts/build-catalog-fallback.mjs && node horizon/scripts/validate-catalog.mjs && node horizon/scripts/build-public-artifact.mjs",
    "audit:horizon-pages": "node horizon/scripts/build-public-artifact.mjs --audit-only",
    "preview": "vite preview",
    "preview:pages": "npm run build:pages && vite preview --host 0.0.0.0",
    "sync:store": "node scripts/sync-store.mjs",
    "sync:console": "node scripts/sync-console.mjs",
    "sync:all": "node scripts/sync-store.mjs && node scripts/sync-console.mjs && node scripts/write-build-source-manifest.mjs",
    "console:server": "node console/server.js",
    "audit:overlay": "node scripts/audit-storefront-overlay.cjs",
    "clean:overlay": "node scripts/clean-storefront-overlay.mjs",
    "deploy:catalog": "node scripts/deploy-store-catalog.mjs",
    "curate:catalog": "node scripts/curate-catalog-lanes.mjs",
    "deploy:server": "node scripts/catalog-deploy-server.mjs",
    "deploy:nxcore": "pwsh -File scripts/deploy-nxcore.ps1",
    "nxcore:sku-map": "pwsh -File scripts/nxcore-sku-map-deploy.ps1",
    "audit:repo": "node scripts/audit-orphans.mjs",
    "audit:storefront": "node scripts/audit-storefront.mjs",
    "audit:storefront-conversion": "node scripts/audit-storefront-conversion.mjs",
    "audit:folder-duplicates": "node scripts/audit-folder-duplicates.mjs",
    "tag:folder-roles": "node scripts/tag-folder-roles.mjs",
    "audit:commerce-contract:live": "node scripts/audit-commerce-contract.mjs --live",
    "audit:commerce-schemas": "node scripts/audit-commerce-schemas.mjs",
    "audit:commerce-v1-contract": "node scripts/audit-commerce-v1-contract.mjs",
    "audit:checkout-keys": "node scripts/audit-checkout-keys.mjs",
    "audit:checkout-collisions": "node scripts/audit-checkout-variation-collisions.mjs",
    "audit:ops-endpoint": "node scripts/audit-ops-endpoint.mjs",
    "test:fulfillment-status": "python scripts/fulfillment_status.py",
    "verify:ops-fulfillment": "node scripts/verify-ops-fulfillment-display.mjs",
    "build:cart-sku-map": "node scripts/build-cart-sku-map.mjs",
    "verify:checkout-fix": "node scripts/verify-live-checkout-fix.mjs",
    "deploy:gear-api-proxy": "npx wrangler deploy --config cloudflare/gear-api-proxy/wrangler.toml",
    "pull:square-catalog": "python scripts/pull-square-catalog.py",
    "pull:printful-horizon": "python horizon/scripts/pull-printful-products.py",
    "merge:square-catalog": "node scripts/merge-square-catalog-to-storefront.mjs",
    "catalog:refresh": "npm run pull:square-catalog && npm run merge:square-catalog && npm run curate:catalog && npm run sync:all"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "playwright": "^1.49.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
